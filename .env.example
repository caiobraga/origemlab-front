# Público no build (Vite). Produção: configure no GitHub Actions (secrets/vars) no passo de build.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# URL base da API (origemlab-backend), ex: https://api.seudominio.com — sem barra no final
VITE_API_BASE_URL=
## Assistente de Edital
# Com VITE_API_BASE_URL definido, o chat usa POST /api/edital-chat no backend (recomendado).
# Para forçar o webhook legado (n8n), defina VITE_CHAT_USE_WEBHOOK=true
VITE_CHAT_USE_WEBHOOK=
# Fallback quando não há backend (legado):
VITE_CHAT_ENDPOINT=
VITE_OLLAMA_MODEL=
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=
VITE_APP_TITLE=
VITE_APP_LOGO=
