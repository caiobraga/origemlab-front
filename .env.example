# Público no build (Vite). Produção: configure no GitHub Actions (secrets/vars) no passo de build.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# URL canônica do front (sem barra no final). Usada nos links de confirmação de email.
# Ex.: https://www.origemlabsolutions.com — precisa estar em Supabase → Authentication → Redirect URLs
# (adicione também https://www.origemlabsolutions.com/auth/callback).
VITE_APP_BASE_URL=https://www.origemlabsolutions.com
# URL base da API (Cloudflare Worker), ex: https://api.origemlabsolutions.com — sem barra no final
VITE_API_BASE_URL=https://api.origemlabsolutions.com
## Assistente de Edital
# Com VITE_API_BASE_URL definido, o chat usa POST /api/edital-chat no backend (recomendado).
# Em produção não aponte VITE_CHAT_ENDPOINT para Ollama :11434.
# Para forçar o webhook legado (n8n), defina VITE_CHAT_USE_WEBHOOK=true
VITE_CHAT_USE_WEBHOOK=
# Fallback quando não há backend (legado / local):
VITE_CHAT_ENDPOINT=
# Só para testes locais com path Ollama (bloqueado em produção)
VITE_OLLAMA_MODEL=
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=
VITE_APP_TITLE=
VITE_APP_LOGO=

# true (default) = acesso aberto para testes; false = cobrança / paywall na UI
VITE_OPEN_ACCESS=true
