# Público no build (Vite). Produção: configure no GitHub Actions (secrets/vars) no passo de build.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# URL base da API (origemlab-backend), ex: https://api.seudominio.com — sem barra no final
VITE_API_BASE_URL=
## Chat endpoint (opcional)
# - Se apontar para Ollama (ex: http://3.81.132.92:11434), o app chama POST /api/chat.
# - Se apontar para um webhook (ex: n8n), o app faz POST direto para a URL.
VITE_CHAT_ENDPOINT=
VITE_OLLAMA_MODEL=
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=
VITE_APP_TITLE=
VITE_APP_LOGO=
