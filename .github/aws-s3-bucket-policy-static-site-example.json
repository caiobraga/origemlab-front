{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadAllObjects",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::REPLACE_WITH_FRONT_BUCKET_NAME/*"
    },
    {
      "Sid": "PublicListBucketOptional",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REPLACE_WITH_FRONT_BUCKET_NAME"
    }
  ]
}
