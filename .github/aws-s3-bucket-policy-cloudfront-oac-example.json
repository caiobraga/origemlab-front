{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowCloudFrontReadViaOAC",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudfront.amazonaws.com"
      },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::REPLACE_WITH_FRONT_BUCKET_NAME/*",
      "Condition": {
        "StringEquals": {
          "aws:SourceArn": "arn:aws:cloudfront::REPLACE_WITH_AWS_ACCOUNT_ID:distribution/REPLACE_WITH_CLOUDFRONT_DISTRIBUTION_ID"
        }
      }
    }
  ]
}
